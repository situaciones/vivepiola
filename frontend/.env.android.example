# Copiar como .env.android.local (no se versiona) antes de `npm run build:android`.
# La app del telefono no comparte dominio con Django como el sitio web, asi que
# necesita la direccion completa del backend. En pruebas, la IP del PC en la
# red WiFi (ipconfig) con `runserver 0.0.0.0:8000`; en produccion, https://vivepiola.cl/api.
VITE_API_URL=http://192.168.1.82:8000/api
VITE_GOOGLE_CLIENT_ID=
