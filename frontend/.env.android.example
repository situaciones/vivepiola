# Solo para probar la app contra un Django local: copiar como .env.android.local
# (no se versiona; pisa a .env.android) con la IP del PC en la red WiFi
# (ipconfig) y `runserver 0.0.0.0:8000`. Ese backend va por http, asi que para
# esa prueba hay que poner temporalmente "cleartext": true en capacitor.config.json.
# Borrar el .local antes de compilar la version que se publica.
VITE_API_URL=http://192.168.1.82:8000/api
VITE_GOOGLE_CLIENT_ID=
